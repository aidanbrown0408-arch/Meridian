<script>
(function () {
  var STRATS = {{ v.strats | tojson }};
  var KEY = 'meridian.tab';
  var tabs = document.querySelectorAll('.tab');

  function store(k, val) { try { sessionStorage.setItem(k, val); } catch (e) {} }
  function load(k) { try { return sessionStorage.getItem(k); } catch (e) { return null; } }

  function show(id) {
    if (!document.getElementById('p-' + id)) id = 'overview';
    document.querySelectorAll('.page').forEach(function (p) { p.classList.toggle('active', p.id === 'p-' + id); });
    tabs.forEach(function (t) {
      var on = t.dataset.tab === id;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', on);
    });
    store(KEY, id);
    if (location.hash !== '#' + id) history.replaceState(null, '', '#' + id);
  }
  tabs.forEach(function (t) { t.addEventListener('click', function () { show(t.dataset.tab); window.scrollTo(0, 0); }); });
  window.addEventListener('hashchange', function () { show(location.hash.slice(1)); });

  // Survive the 60s auto-refresh: same tab, same scroll position.
  show(location.hash.slice(1) || load(KEY) || 'overview');
  var y = parseInt(load('meridian.y') || '0', 10);
  if (y) window.scrollTo(0, y);
  window.addEventListener('beforeunload', function () { store('meridian.y', String(window.scrollY)); });

  // Strategy detail modal.
  var modal = document.getElementById('modal');
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function kv(k, val, cls) { return '<div class="kv"><span>' + k + '</span><span class="' + (cls || '') + '">' + esc(val) + '</span></div>'; }
  function openStrat(name) {
    var s = STRATS[name]; if (!s) return;
    document.getElementById('m-title').textContent = name;
    document.getElementById('m-sub').textContent = s.style + ' · ' + s.status.toUpperCase();
    var html = kv('Best symbol', s.symbol) +
      kv('Sharpe', s.sharpe === null ? '—' : s.sharpe) +
      kv('CAGR', s.cagr === null ? '—' : s.cagr + '%', s.cagr === null ? '' : (s.cagr >= 0 ? 'up' : 'dn')) +
      kv('Max drawdown', s.max_drawdown === null ? '—' : s.max_drawdown + '%') +
      kv('Walk-forward', s.walkforward) +
      kv('Position size', s.position_pct === null ? '—' : s.position_pct + '%') +
      kv('Regime on best symbol', s.regime, 'gld');
    if (s.per_symbol.length) {
      html += '<div class="shdr">By symbol</div><table><tr><th>Symbol</th><th class="num">Sharpe</th><th class="num">Folds</th><th class="num">Max DD</th><th></th></tr>';
      s.per_symbol.forEach(function (p) {
        html += '<tr><td>' + esc(p.symbol) + '</td><td class="num">' + p.sharpe + '</td><td class="num">' + p.folds +
          '</td><td class="num">' + p.dd + '%</td><td><span class="bdg ' + (p.eligible ? 'pass' : 'fail') + '">' + (p.eligible ? 'pass' : 'fail') + '</span></td></tr>';
      });
      html += '</table>';
    }
    var note = s.status === 'live' ? "Live and sized today by Charles's risk parity, adjusted for Greg's regime read."
      : s.status === 'watch' ? 'Passed walk-forward but not sized today: roster cap or a shared correlated slot.'
      : (s.reason ? 'Benched: ' + s.reason : '');
    if (note) html += '<div class="mnote">' + esc(note) + '</div>';
    document.getElementById('m-body').innerHTML = html;
    modal.classList.add('open'); modal.setAttribute('aria-hidden', 'false');
  }
  function closeModal() { modal.classList.remove('open'); modal.setAttribute('aria-hidden', 'true'); }
  document.querySelectorAll('tr[data-strat]').forEach(function (r) {
    r.addEventListener('click', function () { openStrat(r.dataset.strat); });
    r.addEventListener('keydown', function (e) { if (e.key === 'Enter') openStrat(r.dataset.strat); });
  });
  modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
  document.getElementById('m-close').addEventListener('click', closeModal);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });
})();
</script>
<script>{{ chart_lib_js()|safe }}</script>
<script>
(function () {
  var A = {{ v.active | tojson }};
  if (!window.LightweightCharts) {
    var host = document.getElementById('at-open');
    if (host && A.open.length) host.innerHTML = '<p class="empty">Chart library failed to load — the tables on the TRADES tab still have every number.</p>';
    return;
  }
  var LC = window.LightweightCharts;
  var C = {bg:'#142544', text:'#A8A190', grid:'rgba(212,175,106,.07)', line:'rgba(212,175,106,.18)',
           up:'#7FBF7F', dn:'#C97A7A', parch:'#E8E3D3', gold:'#D4AF6A'};
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
  function load(k) { try { return sessionStorage.getItem(k); } catch (e) { return null; } }
  function store(k, v) { try { sessionStorage.setItem(k, v); } catch (e) {} }
  function fmt(x, d) { return x == null ? '—' : Number(x).toLocaleString('en-US', {minimumFractionDigits: d == null ? 2 : d, maximumFractionDigits: d == null ? 2 : d}); }
  function swatch(color, dash) {
    return '<svg width="22" height="8" aria-hidden="true"><line x1="1" y1="4" x2="21" y2="4" stroke="' + color + '" stroke-width="2"' + (dash ? ' stroke-dasharray="4 3"' : '') + '/></svg>';
  }

  function cardHtml(c) {
    var chips = '';
    if (c.regime) chips += '<span class="chip">regime: ' + esc(c.regime) + '</span>';
    c.traders.forEach(function (t) {
      chips += '<span class="chip"><i style="background:' + t.color + '"></i>' + esc(t.callsign) +
        (t.attribution === 'inferred' ? ' · inferred' : '') + '</span>';
    });
    if (c.data && c.data.synthetic) chips += '<span class="chip" style="color:var(--red)">synthetic data</span>';
    var stats = c.stats.map(function (s) { return '<div><dt>' + esc(s.label) + '</dt><dd>' + esc(s.value) + '</dd></div>'; }).join('');
    var legend = '';
    c.overlays.forEach(function (o, i) {
      legend += '<button class="lg" type="button" aria-pressed="true" data-ov="' + i + '">' + swatch(o.color, o.dash) + esc(o.label) + '</button>';
    });
    c.price_lines.forEach(function (p) { legend += '<span class="lg static">' + swatch(p.color, p.dash) + esc(p.label) + ' ' + fmt(p.price) + '</span>'; });
    if (c.markers.some(function (m) { return m.shape === 'circle'; }))
      legend += '<span class="lg static">● signal: entry below the bar, exit above</span>';
    if (c.markers.some(function (m) { return m.shape !== 'circle'; }))
      legend += '<span class="lg static"><span class="up">▲</span> buy / <span class="dn">▼</span> sell fill</span>';
    var rules = '';
    if (c.status === 'open') {
      c.traders.forEach(function (t) {
        rules += '<div class="rule" style="border-left-color:' + t.color + '"><div class="h"><b>' + esc(t.callsign) + '</b><span class="bdg ' +
          (t.signal_now === 'active' ? 'live' : 'flat') + '">' + (t.signal_now === 'active' ? 'signal active' : 'signal flat') + '</span></div>' +
          (t.style ? '<div class="k">' + esc(t.style) + '</div>' : '') +
          '<div><span class="k">Entry:</span> ' + esc(t.entry) + '</div><div><span class="k">Exit:</span> ' + esc(t.exit) + '</div>' +
          (t.status ? '<div class="now">' + esc(t.status) + '</div>' : '') + '</div>';
      });
    }
    var notes = c.notes.map(function (n) { return '<div class="' + (/SYNTHETIC|isn't in this run|unknown, not zero/.test(n) ? 'bad' : '') + '">' + esc(n) + '</div>'; }).join('');
    var fills = c.markers.filter(function (m) { return m.shape !== 'circle'; });
    var ftable = fills.length ? '<details class="fills"><summary>Fills table (' + fills.length + ')</summary><table><tr><th>Bar</th><th>Fill</th></tr>' +
      fills.map(function (m) { return '<tr><td>' + esc(m.time) + '</td><td>' + esc(m.text) + '</td></tr>'; }).join('') + '</table></details>' : '';
    var d = c.data || {};
    var h = c.headline || {};
    return '<div class="card tc" id="' + c.id + '">' +
      '<div class="tc-hdr"><div><div class="tc-title">' + esc(c.title) + '</div><div class="tc-sub">' + esc(c.subtitle) + '</div><div class="tc-chips">' + chips + '</div></div>' +
      '<div class="tc-pnl"><div class="l">' + esc(h.label) + '</div><div class="v ' + (h.cls || '') + '">' + esc(h.value) + '</div><div class="p ' + (h.cls || '') + '">' + esc(h.pct) + '</div></div></div>' +
      '<dl class="tc-stats">' + stats + '</dl>' +
      '<div class="tc-legend">' + legend + '</div>' +
      '<div class="tc-ohlc" aria-live="off"></div>' +
      '<div class="panes"></div>' +
      (rules ? '<div class="tc-rules">' + rules + '</div>' : '') +
      (notes ? '<div class="tc-notes">' + notes + '</div>' : '') + ftable +
      '<div class="tc-foot"><span class="' + (d.stale ? 'stale' : '') + '">Prices: ' + esc(d.source) + ', through ' + esc(d.through) + (d.stale ? ' (expected ' + esc(d.expected) + ')' : '') + '</span><span>' + esc(c.pnl_label) + ' in the bottom pane</span></div>' +
      '</div>';
  }

  function mkChart(el, height, opts) {
    var base = {
      height: height, autoSize: true,
      layout: {background: {type: 'solid', color: C.bg}, textColor: C.text, fontFamily: 'Georgia, serif', fontSize: 11},
      grid: {vertLines: {color: C.grid}, horzLines: {color: C.grid}},
      rightPriceScale: {borderColor: C.line, minimumWidth: 74},
      timeScale: {borderColor: C.line, rightOffset: 3, minBarSpacing: 2},
      crosshair: {mode: 0, vertLine: {color: 'rgba(232,227,211,.35)', labelBackgroundColor: '#1A3055'},
                  horzLine: {color: 'rgba(232,227,211,.35)', labelBackgroundColor: '#1A3055'}},
      handleScale: {axisPressedMouseMove: {time: true, price: false}},
      localization: {locale: 'en-US', dateFormat: 'yyyy-MM-dd'}
    };
    if (opts && opts.layout) base.layout = Object.assign({}, base.layout, opts.layout);
    var ch = LC.createChart(el, base);
    el.style.height = height + 'px';
    return ch;
  }

  // Pad a series with whitespace on every candle date so all panes share
  // one logical index and pan/zoom together exactly.
  function pad(points, dates) {
    var have = {}; points.forEach(function (p) { have[p.time] = p; });
    var lo = points.length ? points[0].time : null, hi = points.length ? points[points.length - 1].time : null;
    var out = [];
    dates.forEach(function (d) { out.push(have[d] ? have[d] : {time: d}); });
    // keep points that fall on dates not in the candle set (e.g. option marks on a holiday-less run)
    points.forEach(function (p) { if (dates.indexOf(p.time) < 0) out.push(p); });
    out.sort(function (a, b) { return a.time < b.time ? -1 : a.time > b.time ? 1 : 0; });
    return out;
  }

  function draw(c) {
    var root = document.getElementById(c.id);
    if (!root || root.dataset.drawn) return;
    root.dataset.drawn = '1';
    var panesEl = root.querySelector('.panes');
    var dates = c.candles.map(function (b) { return b.time; });
    var charts = [], prim = [];

    function pane(label, h) {
      var p = document.createElement('div'); p.className = 'pane';
      if (label) { var l = document.createElement('div'); l.className = 'pane-l'; l.textContent = label; p.appendChild(l); }
      panesEl.appendChild(p);
      // TradingView's attribution mark on the price pane only.
      return mkChart(p, h, charts.length ? {layout: {attributionLogo: false}} : null);
    }

    var narrow = window.innerWidth < 640;
    var price = pane(c.book === 'options' ? c.symbol + ' (underlying)' : '', narrow ? 260 : 330);
    var candles = price.addCandlestickSeries({upColor: C.up, downColor: C.dn, wickUpColor: C.up, wickDownColor: C.dn, borderVisible: false,
                                              priceFormat: {type: 'price', precision: 2, minMove: 0.01}});
    candles.setData(c.candles);
    var ovSeries = c.overlays.map(function (o) {
      var s = price.addLineSeries({color: o.color, lineWidth: 2, lineStyle: o.dash ? 2 : 0, lineType: o.step ? 1 : 0,
                                   priceLineVisible: false, lastValueVisible: true, crosshairMarkerVisible: false, title: ''});
      s.setData(pad(o.points, dates));
      return s;
    });
    c.price_lines.forEach(function (p) {
      candles.createPriceLine({price: p.price, color: p.color, lineWidth: 1, lineStyle: p.dash ? 2 : 0, axisLabelVisible: true, title: p.label});
    });
    var inRange = function (m) { return m.time >= dates[0] && m.time <= dates[dates.length - 1]; };
    candles.setMarkers(c.markers.filter(inRange).map(function (m) {
      return {time: m.time, position: m.position, shape: m.shape, color: m.color, size: m.size || 1,
              text: m.shape === 'circle' ? '' : m.text};
    }));
    charts.push(price); prim.push(candles);

    c.panes.forEach(function (pn) {
      var ch = pane(pn.label, 110);
      if (pn.min != null) ch.applyOptions({rightPriceScale: {scaleMargins: {top: 0.08, bottom: 0.08}}});
      var s = ch.addLineSeries({color: pn.color, lineWidth: 2, priceLineVisible: false, lastValueVisible: true,
        autoscaleInfoProvider: pn.min != null ? function () { return {priceRange: {minValue: pn.min, maxValue: pn.max}}; } : undefined});
      s.setData(pad(pn.points, dates));
      (pn.levels || []).forEach(function (lv) {
        s.createPriceLine({price: lv.value, color: 'rgba(232,227,211,.45)', lineWidth: 1, lineStyle: 2, axisLabelVisible: true, title: lv.label});
      });
      charts.push(ch); prim.push(s);
    });

    var pnlSeries = null;
    if (c.pnl.length) {
      var pc = pane(c.pnl_label, 120);
      pnlSeries = pc.addBaselineSeries({baseValue: {type: 'price', price: 0}, lineWidth: 2,
        topLineColor: C.up, topFillColor1: 'rgba(127,191,127,.28)', topFillColor2: 'rgba(127,191,127,.04)',
        bottomLineColor: C.dn, bottomFillColor1: 'rgba(201,122,122,.04)', bottomFillColor2: 'rgba(201,122,122,.28)',
        priceLineVisible: false, priceFormat: {type: 'price', precision: 2, minMove: 0.01}});
      pnlSeries.setData(pad(c.pnl, dates));
      pnlSeries.createPriceLine({price: 0, color: 'rgba(232,227,211,.3)', lineWidth: 1, lineStyle: 2, axisLabelVisible: false, title: ''});
      charts.push(pc); prim.push(pnlSeries);
    }

    // Only the bottom pane shows the time axis.
    charts.forEach(function (ch, i) { ch.applyOptions({timeScale: {visible: i === charts.length - 1}}); });

    // Sync pan/zoom across panes, and remember it across the 60s auto-refresh.
    var syncing = false, key = 'meridian.range.' + c.id;
    charts.forEach(function (src) {
      src.timeScale().subscribeVisibleLogicalRangeChange(function (r) {
        if (syncing || !r) return;
        syncing = true;
        charts.forEach(function (dst) { if (dst !== src) dst.timeScale().setVisibleLogicalRange(r); });
        syncing = false;
        store(key, JSON.stringify(r));
      });
    });
    var saved = load(key);
    if (saved) { try { price.timeScale().setVisibleLogicalRange(JSON.parse(saved)); } catch (e) {} }
    else { price.timeScale().setVisibleLogicalRange({from: Math.max(0, dates.length - (narrow ? 70 : 130)), to: dates.length + 2}); }

    // Hover readout: OHLC + every overlay value on the hovered bar.
    var ohlc = root.querySelector('.tc-ohlc');
    function readout(t) {
      var i = t ? dates.indexOf(t) : dates.length - 1;
      if (i < 0) i = dates.length - 1;
      var b = c.candles[i], html = '<b>' + esc(b.time) + '</b> &nbsp;O ' + fmt(b.open) + ' H ' + fmt(b.high) + ' L ' + fmt(b.low) + ' C <b>' + fmt(b.close) + '</b>';
      c.overlays.forEach(function (o) {
        var p = null; for (var k = 0; k < o.points.length; k++) { if (o.points[k].time === b.time) { p = o.points[k]; break; } }
        if (p) html += ' &nbsp;·&nbsp; ' + esc(o.label) + ' ' + fmt(p.value);
      });
      for (var k = 0; k < c.pnl.length; k++) if (c.pnl[k].time === b.time) { html += ' &nbsp;·&nbsp; P&amp;L <b>' + fmt(c.pnl[k].value) + '</b>'; break; }
      ohlc.innerHTML = html;
    }
    readout(null);
    charts.forEach(function (src) {
      src.subscribeCrosshairMove(function (param) {
        readout(param && param.time ? param.time : null);
        if (syncing) return;
        syncing = true;
        charts.forEach(function (dst, j) {
          if (dst === src || !dst.setCrosshairPosition) return;
          if (param && param.time) dst.setCrosshairPosition(NaN, param.time, prim[j]);
          else dst.clearCrosshairPosition();
        });
        syncing = false;
      });
    });

    // Legend toggles.
    root.querySelectorAll('button[data-ov]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var on = btn.getAttribute('aria-pressed') !== 'true';
        btn.setAttribute('aria-pressed', on);
        ovSeries[+btn.dataset.ov].applyOptions({visible: on});
      });
    });
  }

  var openHost = document.getElementById('at-open');
  if (openHost) openHost.innerHTML = A.open.map(cardHtml).join('');
  var closedHost = document.getElementById('at-closed');
  if (closedHost) {
    closedHost.innerHTML = A.closed.map(function (c) {
      var h = c.headline || {};
      return '<details class="closed" data-id="' + c.id + '"><summary><span>' + esc(c.title) + ' <span class="mut">· ' +
        esc(c.traders.map(function (t) { return t.callsign; }).join(', ') || 'unattributed') + ' · ' + esc(c.subtitle) + '</span></span><span class="r ' + (h.cls || '') + '">' +
        esc(h.value) + ' ' + esc(h.pct) + '</span></summary>' + cardHtml(c) + '</details>';
    }).join('');
    closedHost.querySelectorAll('details.closed').forEach(function (d) {
      d.addEventListener('toggle', function () {
        if (d.open) { var c = A.closed.filter(function (x) { return x.id === d.dataset.id; })[0]; if (c) draw(c); }
      });
    });
  }

  // Draw open cards when the tab is first shown (charts need a laid-out width).
  function drawOpen() { A.open.forEach(draw); }
  var page = document.getElementById('p-active');
  if (page && page.classList.contains('active')) drawOpen();
  document.querySelectorAll('.tab[data-tab="active"]').forEach(function (t) { t.addEventListener('click', function () { setTimeout(drawOpen, 0); }); });
  window.addEventListener('hashchange', function () { if (location.hash === '#active') setTimeout(drawOpen, 0); });
})();
</script>
</body>
</html>
