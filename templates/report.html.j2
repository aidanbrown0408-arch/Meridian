    {% for s in v.active.summary %}
    <div class="card stat"><div class="eyebrow">{{ s.label }}</div><div class="v {{ s.cls }}">{{ s.value }}</div><div class="s" title="{{ s.sub }}">{{ s.sub }}</div></div>
    {% endfor %}
  </div>
  <div id="at-open"></div>
