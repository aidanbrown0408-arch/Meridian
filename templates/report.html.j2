      </div>
      {% if v.signals %}
      <div class="shdr">Options trigger today <span class="aside">{{ v.signals[0].trigger }}</span></div>
      <div class="sigs">
        {% for s in v.signals %}
        <div class="sig">{{ s.underlying }} <span class="bdg {{ 'long' if s.signal_long else 'flat' }}">{{ 'long' if s.signal_long else 'flat' }}</span></div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
</section>

<!-- ======================= ACTIVE TRADES ======================= -->
<section id="p-active" class="page" role="tabpanel">
  <div class="shdr">Active trades <span class="aside">daily bars · fills from the ledgers · each trader's own indicator</span></div>
